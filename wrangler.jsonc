{
  // 모래성과 동일한 방식: Cloudflare Worker가 로그인 후에만 정적 앱을 제공해.
  // 비밀 ACCESS_KEY는 이 파일에 쓰지 말고 Cloudflare Worker의 Secret으로 저장해.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interviews",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
